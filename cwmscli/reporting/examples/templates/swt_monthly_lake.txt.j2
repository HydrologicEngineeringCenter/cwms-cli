{%- set title = options.title or (project ~ " Lake") -%}
{%- set top_conservation = options.top_conservation_display or 0 -%}
{%- set top_flood = options.top_flood_display or 0 -%}
{%- set inflow_factor = options.cfs_day_to_acre_feet or 1.9835 -%}
{%- set datum_label = options.datum_label or "FT-NGVD" -%}
{%- set month_label = month.label if options.month_label_format == "full" else month.abbr ~ " " ~ month.start.year -%}
{%- set normal_rainfall = options.normal_rainfall or 4.19 -%}
{%- set report_overrides = options.report_overrides if options.report_overrides is defined else {} -%}
{%- set month_overrides = report_overrides.get(month.start.strftime("%Y-%m"), {}) -%}
{%- set daily_overrides = month_overrides.get("daily", {}) -%}
{%- set summary_overrides = month_overrides.get("summary", {}) -%}
{%- macro fixed_line(fields) -%}
{%- set ns = namespace(text="") -%}
{%- for field in fields -%}
{%- set start = field[0] -%}
{%- set value = field[1]|string -%}
{%- if ns.text|length < start - 1 -%}
{%- set ns.text = ns.text + (" " * (start - 1 - (ns.text|length))) -%}
{%- endif -%}
{%- set ns.text = ns.text + value -%}
{%- endfor -%}
{{- ns.text -}}
{%- endmacro -%}
{%- set missing_power_release = options.missing_power_release if options.missing_power_release is defined else none -%}
{%- set missing_total_release = options.missing_total_release if options.missing_total_release is defined else none -%}
{%- set missing_evaporation = options.missing_evaporation if options.missing_evaporation is defined else none -%}
{%- set missing_rainfall_dam = options.missing_rainfall_dam if options.missing_rainfall_dam is defined else none -%}
{%- set missing_rainfall_basin = options.missing_rainfall_basin if options.missing_rainfall_basin is defined else none -%}
{%- set lines = [] -%}
{%- set prior_elev = value_at("elevation", month.start) -%}
{%- set prior_storage = value_at("storage", month.start) -%}
{%- do lines.append("    POOL ELEVATIONS  STORAGE     RELEASES       EVAP  INFLOW   RAINFALL") -%}
{%- do lines.append("DAY      %-7s     2400HR         DSF        INCHES   ADJ     INCHES"|format(datum_label)) -%}
{%- do lines.append("      0800    2400    AC-FT   POWER    TOTAL  8A TO 8A  DSF    7A TO  7A") -%}
{%- do lines.append("                                                               DAM   BSN") -%}
{%- do lines.append("PRIOR MONTH%8s  %7s"|format(fmt_float(prior_elev, 2), fmt_int(prior_storage))) -%}
{%- set ns = namespace(power_total=0.0, release_total=0.0, evap_total=0.0, inflow_total=0, dam_rain_total=0.0, basin_rain_total=0.0, elev_total=0.0, elev_count=0) -%}
{%- for day in range(1, month.days + 1) -%}
{%- set day_start = add_days(month.start, day - 1) -%}
{%- set day_end = add_days(day_start, 1) -%}
{%- set day_overrides = daily_overrides.get(day|string, {}) -%}
{%- set elev_0800 = value_at("elevation", at_time(day_start, 8)) -%}
{%- set elev_2400 = value_at("elevation", day_end) -%}
{%- set storage = value_at("storage", day_end) -%}
{%- set power = value_at("power_release", day_end) -%}
{%- if power is none and missing_power_release is not none -%}
{%- set power = missing_power_release -%}
{%- endif -%}
{%- set release = value_at("total_release", day_end) -%}
{%- if release is none and missing_total_release is not none -%}
{%- set release = missing_total_release -%}
{%- endif -%}
{%- set evap = value_at("evaporation", at_time(day_start, 7)) -%}
{%- if evap is none and missing_evaporation is not none -%}
{%- set evap = missing_evaporation -%}
{%- endif -%}
{%- set inflow = value_at("inflow", day_end) -%}
{%- set dam_rain = value_at("rainfall_dam", at_time(day_start, 7)) -%}
{%- if dam_rain is none and missing_rainfall_dam is not none -%}
{%- set dam_rain = missing_rainfall_dam -%}
{%- endif -%}
{%- set basin_rain = value_at("rainfall_basin", at_time(day_start, 7)) -%}
{%- if basin_rain is none and missing_rainfall_basin is not none -%}
{%- set basin_rain = missing_rainfall_basin -%}
{%- endif -%}
{%- set inflow_rounded = round_int(inflow) -%}
{%- set ns.power_total = ns.power_total + (power or 0) -%}
{%- set ns.release_total = ns.release_total + (release or 0) -%}
{%- set ns.evap_total = ns.evap_total + (evap or 0) -%}
{%- set ns.inflow_total = ns.inflow_total + (inflow_rounded or 0) -%}
{%- set ns.dam_rain_total = ns.dam_rain_total + (dam_rain or 0) -%}
{%- set ns.basin_rain_total = ns.basin_rain_total + (basin_rain or 0) -%}
{%- if elev_2400 is not none -%}
{%- set ns.elev_total = ns.elev_total + elev_2400 -%}
{%- set ns.elev_count = ns.elev_count + 1 -%}
{%- endif -%}
{%- set elev_0800_display = day_overrides.get("elevation_0800", elev_0800) -%}
{%- set elev_2400_display = day_overrides.get("elevation_2400", elev_2400) -%}
{%- set storage_display = day_overrides.get("storage", storage) -%}
{%- set power_display = day_overrides.get("power_release", power) -%}
{%- set release_display = day_overrides.get("total_release", release) -%}
{%- set evap_display = day_overrides.get("evaporation", evap) -%}
{%- set inflow_display = day_overrides.get("inflow", inflow) -%}
{%- set dam_rain_display = day_overrides.get("rainfall_dam", dam_rain) -%}
{%- set basin_rain_display = day_overrides.get("rainfall_basin", basin_rain) -%}
{%- set day_text = "%d"|format(day) -%}
{%- set elev_0800_text = fmt_float(elev_0800_display, 2) -%}
{%- set elev_2400_text = fmt_float(elev_2400_display, 2) -%}
{%- set storage_text = fmt_int(storage_display) -%}
{%- set power_text = fmt_int(power_display) -%}
{%- set release_text = fmt_int(release_display) -%}
{%- set evap_text = fmt_float(evap_display, 3) -%}
{%- set inflow_text = fmt_int(inflow_display) -%}
{%- set dam_rain_text = fmt_float(dam_rain_display, 2) -%}
{%- set basin_rain_text = fmt_float(basin_rain_display, 2) -%}
{%- do lines.append(fixed_line([(3 - (day_text|length), day_text), (12 - (elev_0800_text|length), elev_0800_text), (20 - (elev_2400_text|length), elev_2400_text), (29 - (storage_text|length), storage_text), (36 - (power_text|length), power_text), (45 - (release_text|length), release_text), (53 - (evap_text|length), evap_text), (61 - (inflow_text|length), inflow_text), (68 - (dam_rain_text|length), dam_rain_text), (74 - (basin_rain_text|length), basin_rain_text)])) -%}
{%- if day % 5 == 0 and day < month.days - 1 -%}
{%- do lines.append("") -%}
{%- endif -%}
{%- endfor -%}
{%- set max_elev = max_row("elevation", month.start, month.end, "last", 2) -%}
{%- set min_elev = min_row("elevation", month.start, month.end, "last", 2) -%}
{%- set max_storage = value_at("storage", max_elev["date-time"]) -%}
{%- set min_storage = value_at("storage", min_elev["date-time"]) -%}
{%- set max_elevation_display = summary_overrides.get("max_elevation", max_elev.value) -%}
{%- set max_storage_display = summary_overrides.get("max_storage", max_storage) -%}
{%- set max_day_display = summary_overrides.get("max_day", report_day(max_elev["date-time"], month.start)) -%}
{%- set min_elevation_display = summary_overrides.get("min_elevation", min_elev.value) -%}
{%- set min_storage_display = summary_overrides.get("min_storage", min_storage) -%}
{%- set min_day_display = summary_overrides.get("min_day", report_day(min_elev["date-time"], month.start)) -%}
{%- set total_power_display = summary_overrides.get("total_power", round_int(ns.power_total)) -%}
{%- set total_release_display = summary_overrides.get("total_release", round_int(ns.release_total)) -%}
{%- set total_evaporation_display = summary_overrides.get("total_evaporation", ns.evap_total) -%}
{%- set total_inflow_display = summary_overrides.get("total_inflow", ns.inflow_total) -%}
{%- set total_dam_rain_display = summary_overrides.get("total_rainfall_dam", ns.dam_rain_total) -%}
{%- set total_basin_rain_display = summary_overrides.get("total_rainfall_basin", ns.basin_rain_total) -%}
{%- set total_power_text = "%d"|format(round_int(total_power_display)) -%}
{%- set total_release_text = "%d"|format(round_int(total_release_display)) -%}
{%- set total_evap_text = "%5.3f"|format(total_evaporation_display) -%}
{%- set total_inflow_text = "%d"|format(round_int(total_inflow_display)) -%}
{%- set total_dam_rain_text = "%4.2f"|format(total_dam_rain_display) -%}
{%- set total_basin_rain_text = "%4.2f"|format(total_basin_rain_display) -%}
{%- set total_inflow_end = 61 if total_evap_text|length > 5 else 60 -%}
{%- set total_dam_rain_end = 68 if total_evap_text|length > 5 else 67 -%}
{%- set total_basin_rain_end = 74 if total_evap_text|length > 5 else 73 -%}
{%- set average_power_display = summary_overrides.get("average_power", round_int(ns.power_total) / month.days) -%}
{%- set average_release_display = summary_overrides.get("average_release", round_int(ns.release_total) / month.days) -%}
{%- set average_inflow_display = summary_overrides.get("average_inflow", ns.inflow_total / month.days) -%}
{%- do lines.append("") -%}
{%- do lines.append(fixed_line([(1, "TOTAL"), (36 - (total_power_text|length), total_power_text), (45 - (total_release_text|length), total_release_text), (48, total_evap_text), (total_inflow_end + 1 - (total_inflow_text|length), total_inflow_text), (total_dam_rain_end + 1 - (total_dam_rain_text|length), total_dam_rain_text), (total_basin_rain_end + 1 - (total_basin_rain_text|length), total_basin_rain_text)])) -%}
{%- do lines.append("AVERAGE %8.2f              %5.0f    %5.0f           %5.0f NORMAL= %4.2f"|format(ns.elev_total / ns.elev_count, average_power_display, average_release_display, average_inflow_display, normal_rainfall)) -%}
{%- do lines.append("") -%}
{%- do lines.append("MAXIMUM %8.2f     %7d   DATE=%2d    TOP CONSERVATION POOL      %4.2f"|format(max_elevation_display, round_int(max_storage_display), max_day_display, top_conservation)) -%}
{%- do lines.append("MINIMUM %8.2f     %7d   DATE=%2d    TOP FLOOD POOL             %4.2f"|format(min_elevation_display, round_int(min_storage_display), min_day_display, top_flood)) -%}
{%- do lines.append("") -%}
{%- if options.water_supply_withdrawn_acft is defined -%}
{%- do lines.append("WATER SUPPLY:  WITHDRAWN %6d AC-FT"|format(round_int(options.water_supply_withdrawn_acft))) -%}
{%- do lines.append("") -%}
{%- endif -%}
{%- do lines.append("                      INFLOW VOLUME=  %7d AC-FT"|format(round_int(summary_overrides.get("inflow_volume_acft", ns.inflow_total * inflow_factor)))) -%}
{%- do lines.append("") -%}
{%- do lines.append("") -%}
{%- do lines.append("") -%}
{%- do lines.append("REPORT IS SUBJECT TO CHANGE AND/OR REVISION") -%}
{{- center_legacy_title(title) ~ "\r\n" ~ center("MONTHLY LAKE REPORT") ~ "\r\n" ~ center(month_label) ~ "\n\n\r\n\r\n" ~ (lines | join("\r\n")) -}}
